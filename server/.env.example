# Copia este archivo como .env y rellena los valores
PORT=4000
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/chikastore
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# Orígenes permitidos para CORS (separados por comas)
CLIENT_URL=http://localhost:5173

# Cuenta de administrador que crea `npm run seed`
ADMIN_EMAIL=admin@chikastore.com
ADMIN_PASSWORD=CambiaEstaContraseña123
ADMIN_NAME=Maestro de la Tienda

# Opcional: subida de imágenes de productos a Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
