# Copia este archivo como .env y rellena los valores
PORT=4000
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/chikastore
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# Orígenes permitidos para CORS (separados por comas)
CLIENT_URL=http://localhost:5173

# Cuenta de administrador que crea `npm run seed`
ADMIN_EMAIL=admin@chikastore.com
ADMIN_PASSWORD=CambiaEstaContraseña123
ADMIN_NAME=Maestro de la Tienda

# Opcional: subida de imágenes de productos a Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Recuperar contraseña: correos con Brevo (https://app.brevo.com → SMTP y API → Claves API)
# Sin BREVO_API_KEY el enlace se muestra en la consola del servidor (útil en local).
BREVO_API_KEY=
MAIL_FROM=no-responder@chikakushop.es
MAIL_FROM_NAME=ChikakuShop
# Opcional: fuerza el dominio de los enlaces de los correos (por defecto, el mismo desde el que se pidió)
APP_URL=

# Login con Google (Google Cloud Console → Credenciales → ID de cliente OAuth, tipo "Aplicación web")
GOOGLE_CLIENT_ID=

# Login con Discord (https://discord.com/developers/applications → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Opcional: por defecto https://<este-servidor>/api/auth/discord/callback
DISCORD_REDIRECT_URI=
